<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Coupon Management Dashboard - PixelPlay</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style data-purpose="custom-styles">
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0d0d12;
            color: #e5e7eb;
        }

        /* Custom Scrollbar for Webkit */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #0d0d12;
        }

        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }

        .table-row-hover:hover {
            background-color: #1a1a24;
        }

        .gold-accent {
            color: #eab308;
        }

        .cyan-accent {
            color: #06b6d4;
        }

        .bg-cyan-accent {
            background-color: #06b6d4;
        }

        .input-dark {
            background-color: #1a1a24;
            border-color: #374151;
            color: #e5e7eb;
        }

        .input-dark:focus {
            border-color: #4b5563;
            ring-color: #4b5563;
        }

        /* Toggle Switch Styles */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #06b6d4;
        }

        .toggle-checkbox:checked+.toggle-label {
            background-color: #06b6d4;
        }

        .toggle-label {
            background-color: #4b5563;
            transition: background-color 0.2s ease-in-out;
        }

        .toggle-checkbox {
            right: 4px;
            transition: right 0.2s ease-in-out;
        }
    </style>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="flex h-screen overflow-hidden">
    <!-- BEGIN: Sidebar Navigation -->
    <%- include('../partials/admin/sidebar', { activeTab: 'coupons' }) %>
    <!-- END: Sidebar Navigation -->

    <!-- BEGIN: Main Content Area -->
    <main class="flex-1 flex flex-col bg-[#0d0d12] overflow-hidden relative">
        <!-- Top Header -->
        <header class="flex items-center justify-between px-8 py-6 border-b border-[#1f1f2e]">
            <h1 class="text-2xl font-semibold text-white">Coupon Management</h1>
            <a href="/admin/coupons/new"
                class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-[#06b6d4] hover:bg-[#0891b2] transition-colors focus:outline-none cursor-pointer">
                <i class="mr-2 -ml-1 h-4 w-4" data-lucide="plus"></i>
                Create New Coupon
            </a>
        </header>

        <!-- Content Container -->
        <div class="flex-1 overflow-y-auto p-8">
            <!-- Filters and Search -->
            <form action="/admin/coupons" method="GET" id="filterForm"
                class="bg-[#111118] border border-[#1f1f2e] rounded-lg p-4 mb-6 flex flex-col sm:flex-row gap-4 items-center">
                <div class="relative flex-1 w-full max-w-md">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="h-5 w-5 text-gray-400" data-lucide="search"></i>
                    </div>
                    <input
                        class="block w-full pl-10 sm:text-sm border-[#374151] rounded-md input-dark bg-[#111118] py-2 focus:ring-0 focus:border-gray-500"
                        id="search" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>"
                        placeholder="Search by Code..." type="text" />
                </div>
                <div class="flex gap-4 w-full sm:w-auto">
                    <div class="relative rounded-md shadow-sm w-full sm:w-48">
                        <select onchange="this.form.submit()"
                            class="block w-full pl-3 pr-10 py-2 text-base border-gray-600 focus:outline-none focus:ring-0 focus:border-gray-500 sm:text-sm rounded-md input-dark bg-[#111118] appearance-none cursor-pointer"
                            id="status" name="status">
                            <option value="All" <%= status === 'All' ? 'selected' : '' %>>Status: All</option>
                            <option value="Active" <%= status === 'Active' ? 'selected' : '' %>>Active</option>
                            <option value="Inactive" <%= status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-400">
                            <i class="h-4 w-4" data-lucide="chevron-down"></i>
                        </div>
                    </div>
                    <div class="relative rounded-md shadow-sm w-full sm:w-48">
                        <select onchange="this.form.submit()"
                            class="block w-full pl-3 pr-10 py-2 text-base border-gray-600 focus:outline-none focus:ring-0 focus:border-gray-500 sm:text-sm rounded-md input-dark bg-[#111118] appearance-none cursor-pointer"
                            id="type" name="type">
                            <option value="All" <%= type === 'All' ? 'selected' : '' %>>Coupon Type: All</option>
                            <option value="Percentage" <%= type === 'Percentage' ? 'selected' : '' %>>Percentage</option>
                            <option value="Fixed Amount" <%= type === 'Fixed Amount' ? 'selected' : '' %>>Fixed Amount</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-400">
                            <i class="h-4 w-4" data-lucide="chevron-down"></i>
                        </div>
                    </div>
                    <% if (search || status !== 'All' || type !== 'All') { %>
                        <a href="/admin/coupons" class="px-4 py-2 bg-[#1a1a24] border border-[#374151] rounded-md text-sm text-gray-400 hover:text-white transition-colors">
                            Clear
                        </a>
                    <% } %>
                </div>
            </form>

            <!-- Data Table -->
            <div class="flex flex-col">
                <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                    <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                        <div class="overflow-hidden border-b border-[#1f1f2e]">
                            <table class="min-w-full divide-y divide-[#1f1f2e]">
                                <thead class="bg-[#0d0d12]">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider" scope="col">Code</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider" scope="col">Description &amp; Offer</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider" scope="col">Type &amp; Thresholds</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider" scope="col">Usage Limit</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider" scope="col">Expiry Date</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider" scope="col">Status</th>
                                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-400 uppercase tracking-wider" scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#1f1f2e] bg-[#0d0d12]">
                                    <% if (coupons && coupons.length > 0) { %>
                                        <% coupons.forEach(function(coupon) { %>
                                            <% 
                                                const isExpired = new Date(coupon.expiryDate) <= new Date();
                                                const formattedExpiry = new Date(coupon.expiryDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
                                                const totalLimit = coupon.totalUsageLimit !== null ? coupon.totalUsageLimit : 'Unlimited';
                                                const usagePercent = coupon.totalUsageLimit ? Math.min(100, Math.round((coupon.totalRedemptions / coupon.totalUsageLimit) * 100)) : 0;
                                            %>
                                            <tr class="table-row-hover bg-[#111118] m-2 rounded-lg border border-[#1f1f2e] block md:table-row md:border-0 md:rounded-none md:m-0">
                                                <td class="px-6 py-4 whitespace-nowrap block md:table-cell">
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-[#1a1a24] text-cyan-400 border border-[#2a2a35] tracking-wider">
                                                        <%= coupon.code %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300 block md:table-cell">
                                                    <div class="font-bold text-white">
                                                        <% if (coupon.discountType === 'percentage') { %>
                                                            <%= coupon.discountValue %>% Off
                                                        <% } else { %>
                                                            ₹<%= (coupon.discountValue / 100).toFixed(2) %> Flat Off
                                                        <% } %>
                                                    </div>
                                                    <% if (coupon.description) { %>
                                                        <div class="text-xs text-gray-400 truncate max-w-xs"><%= coupon.description %></div>
                                                    <% } %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap block md:table-cell">
                                                    <div class="flex flex-col gap-1">
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-[#2a2a35] text-gray-300 w-max">
                                                            <%= coupon.minOrderAmount > 0 ? 'Min Order: ₹' + (coupon.minOrderAmount / 100).toFixed(2) : 'No Min Order' %>
                                                        </span>
                                                        <% if (coupon.discountType === 'percentage' && coupon.maxDiscountAmount) { %>
                                                            <span class="text-[11px] text-amber-400">
                                                                Max Cap: ₹<%= (coupon.maxDiscountAmount / 100).toFixed(2) %>
                                                            </span>
                                                        <% } %>
                                                        <span class="text-[11px] text-gray-400">
                                                            Limit: <%= coupon.userUsageLimit %> per user
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap block md:table-cell">
                                                    <div class="flex items-center justify-between text-xs text-gray-400 mb-1 w-32">
                                                        <span><%= coupon.totalRedemptions %> Used</span>
                                                        <span><%= totalLimit %></span>
                                                    </div>
                                                    <div class="w-32 bg-gray-700 rounded-full h-1.5 overflow-hidden">
                                                        <div class="bg-cyan-500 h-1.5 rounded-full" style="width: <%= coupon.totalUsageLimit ? usagePercent : 100 %>%"></div>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm block md:table-cell">
                                                    <span class="<%= isExpired ? 'text-rose-500 font-semibold' : 'text-gray-400' %>">
                                                        <%= formattedExpiry %>
                                                    </span>
                                                    <% if (isExpired) { %>
                                                        <span class="block text-[10px] text-rose-400 uppercase font-bold">Expired</span>
                                                    <% } %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap block md:table-cell">
                                                    <div class="relative inline-block w-10 mr-2 align-middle select-none transition duration-200 ease-in">
                                                        <input type="checkbox"
                                                            class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer z-10 top-0.5"
                                                            id="toggle-<%= coupon._id %>"
                                                            <%= coupon.isActive ? 'checked' : '' %>
                                                            onchange="toggleCoupon('<%= coupon._id %>', this)" />
                                                        <label class="toggle-label block overflow-hidden h-6 rounded-full bg-gray-600 cursor-pointer"
                                                            for="toggle-<%= coupon._id %>"></label>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium block md:table-cell">
                                                    <a href="/admin/coupons/<%= coupon._id %>/edit"
                                                        class="text-gray-400 hover:text-white mr-3 inline-block transition-colors p-1.5" title="Edit Coupon">
                                                        <i class="h-4 w-4" data-lucide="edit-2"></i>
                                                    </a>
                                                    <button onclick="deleteCoupon('<%= coupon._id %>', '<%= coupon.code %>')"
                                                        class="text-gray-400 hover:text-red-500 transition-colors p-1.5 cursor-pointer" title="Delete Coupon">
                                                        <i class="h-4 w-4" data-lucide="trash-2"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                                                <div class="flex flex-col items-center gap-2">
                                                    <i class="h-8 w-8 text-gray-600" data-lucide="ticket"></i>
                                                    <span>No coupons found matching your criteria.</span>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            <div class="flex items-center justify-between border-t border-[#1f1f2e] py-4 mt-6">
                <% 
                    const startCount = totalCount === 0 ? 0 : (currentPage - 1) * limit + 1;
                    const endCount = Math.min(currentPage * limit, totalCount);
                %>
                <div>
                    <p class="text-sm text-gray-400">
                        Showing <span class="font-medium text-gray-300"><%= startCount %>-<%= endCount %></span> of <span class="font-medium text-gray-300"><%= totalCount %></span> coupons
                    </p>
                </div>
                <% if (totalPages > 1) { %>
                    <div>
                        <nav aria-label="Pagination" class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px gap-2">
                            <% if (currentPage > 1) { %>
                                <a href="/admin/coupons?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>&type=<%= encodeURIComponent(type) %>"
                                    class="relative inline-flex items-center px-2 py-2 rounded-md border border-[#374151] bg-[#111118] text-sm font-medium text-gray-400 hover:bg-[#1a1a24]">
                                    <i class="h-4 w-4" data-lucide="chevron-left"></i>
                                </a>
                            <% } %>

                            <% for (let p = 1; p <= totalPages; p++) { %>
                                <% if (p === currentPage) { %>
                                    <span class="z-10 bg-[#06b6d4] bg-opacity-20 border-[#06b6d4] text-[#06b6d4] relative inline-flex items-center px-4 py-2 border text-sm font-medium rounded-md">
                                        <%= p %>
                                    </span>
                                <% } else { %>
                                    <a href="/admin/coupons?page=<%= p %>&search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>&type=<%= encodeURIComponent(type) %>"
                                        class="bg-[#111118] border border-[#374151] text-gray-400 hover:bg-[#1a1a24] relative inline-flex items-center px-4 py-2 text-sm font-medium rounded-md">
                                        <%= p %>
                                    </a>
                                <% } %>
                            <% } %>

                            <% if (currentPage < totalPages) { %>
                                <a href="/admin/coupons?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>&type=<%= encodeURIComponent(type) %>"
                                    class="relative inline-flex items-center px-2 py-2 rounded-md border border-[#374151] bg-[#111118] text-sm font-medium text-gray-400 hover:bg-[#1a1a24]">
                                    <i class="h-4 w-4" data-lucide="chevron-right"></i>
                                </a>
                            <% } %>
                        </nav>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
    <!-- END: Main Content Area -->

    <script>
        lucide.createIcons();

        async function toggleCoupon(couponId, checkbox) {
            try {
                const res = await fetch(`/admin/coupons/${couponId}/status`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    checkbox.checked = !checkbox.checked;
                    Swal.fire({
                        title: 'Error',
                        text: data.message || 'Failed to update status.',
                        icon: 'error',
                        background: '#111118',
                        color: '#e5e7eb'
                    });
                    return;
                }
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: data.message,
                    showConfirmButton: false,
                    timer: 2000,
                    background: '#111118',
                    color: '#e5e7eb'
                });
            } catch (error) {
                checkbox.checked = !checkbox.checked;
                Swal.fire({
                    title: 'Network Error',
                    text: 'Unable to connect to server.',
                    icon: 'error',
                    background: '#111118',
                    color: '#e5e7eb'
                });
            }
        }

        async function deleteCoupon(couponId, code) {
            const result = await Swal.fire({
                title: 'Delete Coupon?',
                text: `Are you sure you want to delete coupon "${code}"? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#374151',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                background: '#111118',
                color: '#e5e7eb'
            });

            if (!result.isConfirmed) return;

            try {
                const res = await fetch(`/admin/coupons/${couponId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    Swal.fire({
                        title: 'Error',
                        text: data.message || 'Failed to delete coupon.',
                        icon: 'error',
                        background: '#111118',
                        color: '#e5e7eb'
                    });
                    return;
                }
                Swal.fire({
                    title: 'Deleted!',
                    text: data.message,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false,
                    background: '#111118',
                    color: '#e5e7eb'
                });
                setTimeout(() => window.location.reload(), 1000);
            } catch (error) {
                Swal.fire({
                    title: 'Network Error',
                    text: 'Unable to connect to server.',
                    icon: 'error',
                    background: '#111118',
                    color: '#e5e7eb'
                });
            }
        }
    </script>
</body>

</html>
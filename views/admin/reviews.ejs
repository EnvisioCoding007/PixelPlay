<%- include('../partials/admin/header') %>

<div class="flex h-screen bg-pixel-bg overflow-hidden text-gray-100 font-sans">
    <%- include('../partials/admin/sidebar', { activeTab: 'reviews', user }) %>

    <main class="flex-1 overflow-y-auto bg-content-bg p-6 lg:p-8 2xl:p-12 w-full">
        <!-- Top Page Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-white tracking-tight flex items-center gap-3">
                    <i class="fa-solid fa-star text-pixel-yellow"></i> Review Moderation & Control
                </h1>
                <p class="text-gray-400 text-sm mt-1">Monitor user feedback, filter ratings, and flag spam or fraudulent reviews.</p>
            </div>
        </div>

        <!-- Summary Stat Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
            <!-- Total Reviews -->
            <div class="bg-card-bg p-5 rounded-2xl border border-border-dark shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Total Reviews</p>
                        <h3 class="text-2xl font-bold text-white mt-2"><%= stats.totalReviews %></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-pixel-blue/10 flex items-center justify-center text-pixel-blue border border-pixel-blue/20">
                        <i class="fa-solid fa-comments text-lg"></i>
                    </div>
                </div>
            </div>

            <!-- Flagged Spam/Fraud Reviews -->
            <div class="bg-card-bg p-5 rounded-2xl border border-border-dark shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Flagged Spam/Fraud</p>
                        <h3 class="text-2xl font-bold text-pixel-red mt-2"><%= stats.flaggedCount %></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-pixel-red/10 flex items-center justify-center text-pixel-red border border-pixel-red/20">
                        <i class="fa-solid fa-flag text-lg"></i>
                    </div>
                </div>
            </div>

            <!-- Platform Avg Rating -->
            <div class="bg-card-bg p-5 rounded-2xl border border-border-dark shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Average Rating</p>
                        <h3 class="text-2xl font-bold text-pixel-yellow mt-2"><%= stats.platformAvgRating %> / 5.0</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-pixel-yellow/10 flex items-center justify-center text-pixel-yellow border border-pixel-yellow/20">
                        <i class="fa-solid fa-star text-lg"></i>
                    </div>
                </div>
            </div>

            <!-- Low Rating Reviews -->
            <div class="bg-card-bg p-5 rounded-2xl border border-border-dark shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Low Ratings (<= 2★)</p>
                        <h3 class="text-2xl font-bold text-orange-400 mt-2"><%= stats.lowRatingCount %></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-400 border border-orange-500/20">
                        <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters Bar -->
        <div class="bg-card-bg p-5 rounded-2xl border border-border-dark shadow-xl mb-8">
            <form method="GET" action="/admin/reviews" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <!-- Search Input -->
                <div class="lg:col-span-2">
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Search Keywords</label>
                    <div class="relative">
                        <input type="text" name="search" value="<%= filters.search %>" placeholder="Search by comment, game title, user email..." class="w-full bg-sidebar-bg border border-input-dark-border text-white text-xs rounded-lg pl-9 pr-3 py-2.5 focus:border-pixel-blue focus:outline-none" />
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-gray-500 text-xs"></i>
                    </div>
                </div>

                <!-- Rating Filter -->
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Rating</label>
                    <select name="rating" onchange="this.form.submit()" class="w-full bg-sidebar-bg border border-input-dark-border text-white text-xs rounded-lg p-2.5 focus:border-pixel-blue focus:outline-none">
                        <option value="All" <%= filters.rating === 'All' ? 'selected' : '' %>>All Ratings</option>
                        <option value="5" <%= filters.rating === '5' ? 'selected' : '' %>>5 Stars ★★★★★</option>
                        <option value="4" <%= filters.rating === '4' ? 'selected' : '' %>>4 Stars ★★★★</option>
                        <option value="3" <%= filters.rating === '3' ? 'selected' : '' %>>3 Stars ★★★</option>
                        <option value="2" <%= filters.rating === '2' ? 'selected' : '' %>>2 Stars ★★</option>
                        <option value="1" <%= filters.rating === '1' ? 'selected' : '' %>>1 Star ★</option>
                    </select>
                </div>

                <!-- Flag Status Filter -->
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Moderation Status</label>
                    <select name="flagStatus" onchange="this.form.submit()" class="w-full bg-sidebar-bg border border-input-dark-border text-white text-xs rounded-lg p-2.5 focus:border-pixel-blue focus:outline-none">
                        <option value="All" <%= filters.flagStatus === 'All' ? 'selected' : '' %>>All Reviews</option>
                        <option value="flagged" <%= filters.flagStatus === 'flagged' ? 'selected' : '' %>>Flagged (Spam/Fraud)</option>
                        <option value="clean" <%= filters.flagStatus === 'clean' ? 'selected' : '' %>>Clean (Unflagged)</option>
                    </select>
                </div>

                <!-- Sort Filter -->
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Sort By</label>
                    <select name="sort" onchange="this.form.submit()" class="w-full bg-sidebar-bg border border-input-dark-border text-white text-xs rounded-lg p-2.5 focus:border-pixel-blue focus:outline-none">
                        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                        <option value="rating_desc" <%= filters.sort === 'rating_desc' ? 'selected' : '' %>>Rating: High to Low</option>
                        <option value="rating_asc" <%= filters.sort === 'rating_asc' ? 'selected' : '' %>>Rating: Low to High</option>
                    </select>
                </div>
            </form>
        </div>

        <!-- Reviews Data Table -->
        <div class="bg-card-bg rounded-2xl border border-border-dark shadow-2xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-gray-300">
                    <thead class="bg-sidebar-bg text-gray-400 uppercase font-bold text-[11px] border-b border-input-dark-border">
                        <tr>
                            <th class="py-3 px-4">Game Title</th>
                            <th class="py-3 px-4">Customer</th>
                            <th class="py-3 px-4">Rating</th>
                            <th class="py-3 px-4">Review Content</th>
                            <th class="py-3 px-4 text-center">Status & Flags</th>
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-input-dark-border/60">
                        <% if (reviews && reviews.length > 0) { %>
                            <% reviews.forEach(review => { %>
                                <tr class="hover:bg-sidebar-bg/60 transition-colors <%= review.is_flagged ? 'bg-pixel-red/5' : '' %>">
                                    <!-- Game -->
                                    <td class="py-3 px-4">
                                        <% if (review.productId) { %>
                                            <div class="flex items-center gap-2.5">
                                                <img src="<%= review.productId.cover_image %>" alt="<%= review.productId.title %>" class="w-9 h-9 rounded object-cover border border-input-dark-border" />
                                                <div>
                                                    <a href="/products/<%= review.productId._id %>" target="_blank" class="font-bold text-white hover:text-pixel-blue line-clamp-1"><%= review.productId.title %></a>
                                                    <span class="text-[10px] text-gray-400"><%= review.productId.publisher %></span>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <span class="text-gray-500 italic">Unlisted Product</span>
                                        <% } %>
                                    </td>

                                    <!-- Customer -->
                                    <td class="py-3 px-4">
                                        <% if (review.userId) { %>
                                            <div>
                                                <span class="font-bold text-gray-200 block"><%= review.userId.username %></span>
                                                <span class="text-[10px] text-gray-400"><%= review.userId.email %></span>
                                            </div>
                                        <% } else { %>
                                            <span class="text-gray-500 italic">Unknown User</span>
                                        <% } %>
                                    </td>

                                    <!-- Rating -->
                                    <td class="py-3 px-4">
                                        <div class="flex items-center gap-1">
                                            <span class="font-bold text-pixel-yellow"><%= review.rating %>.0</span>
                                            <div class="flex text-pixel-yellow text-[10px]">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <i class="fa-solid fa-star <%= i <= review.rating ? 'text-pixel-yellow' : 'text-gray-600' %>"></i>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Comment -->
                                    <td class="py-3 px-4 max-w-xs">
                                        <p class="text-gray-200 text-xs leading-relaxed line-clamp-3"><%= review.comment %></p>
                                    </td>

                                    <!-- Status & Flags -->
                                    <td class="py-3 px-4 text-center">
                                        <div class="flex flex-col items-center gap-1">
                                            <% if (review.is_flagged) { %>
                                                <span class="bg-pixel-red/20 text-pixel-red border border-pixel-red/40 font-bold text-[10px] px-2 py-0.5 rounded-full flex items-center gap-1">
                                                    <i class="fa-solid fa-flag"></i> FLAGGED: <%= review.flag_reason || 'Spam' %>
                                                </span>
                                                <% if (review.flag_notes) { %>
                                                    <span class="text-[9px] text-gray-400 italic line-clamp-1" title="<%= review.flag_notes %>">"<%= review.flag_notes %>"</span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-semibold px-2 py-0.5 rounded-full flex items-center gap-1">
                                                    <i class="fa-solid fa-circle-check"></i> Clean
                                                </span>
                                            <% } %>
                                            
                                            <% if (review.is_verified) { %>
                                                <span class="text-[9px] text-pixel-blue font-semibold">Verified Buyer</span>
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Date -->
                                    <td class="py-3 px-4 text-gray-400 text-[11px]">
                                        <%= new Date(review.createdAt).toLocaleDateString('en-GB') %>
                                    </td>

                                    <!-- Actions -->
                                    <td class="py-3 px-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <% if (review.is_flagged) { %>
                                                <button type="button" onclick="openFlagModal('<%= review._id %>', true, '<%= review.flag_reason %>', '<%= review.flag_notes.replace(/'/g, "\\'") %>')" class="bg-card-bg hover:bg-sidebar-bg text-pixel-yellow border border-input-dark-border px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1" title="Edit Flag">
                                                    <i class="fa-solid fa-pen-to-square"></i> Flag
                                                </button>
                                                <button type="button" onclick="unflagReview('<%= review._id %>')" class="bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1" title="Remove Flag">
                                                    <i class="fa-solid fa-check"></i> Unflag
                                                </button>
                                            <% } else { %>
                                                <button type="button" onclick="openFlagModal('<%= review._id %>', false, '', '')" class="bg-pixel-red/10 hover:bg-pixel-red/20 text-pixel-red border border-pixel-red/30 px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1" title="Flag as Spam/Fraud">
                                                    <i class="fa-solid fa-flag"></i> Flag
                                                </button>
                                            <% } %>

                                            <button type="button" onclick="deleteReviewAdmin('<%= review._id %>')" class="bg-sidebar-bg hover:bg-red-950/60 text-gray-400 hover:text-pixel-red border border-input-dark-border px-2.5 py-1.5 rounded-lg text-xs transition-colors" title="Delete Review">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="py-12 text-center text-gray-500 font-medium">
                                    No reviews matching active filter parameters.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <% if (totalPages > 1) { %>
                <div class="flex items-center justify-between p-4 border-t border-input-dark-border text-xs text-gray-400">
                    <div>
                        Page <span class="font-bold text-white"><%= currentPage %></span> of <span class="font-bold text-white"><%= totalPages %></span> (<%= totalCount %> reviews total)
                    </div>
                    <div class="flex items-center gap-1.5">
                        <% if (currentPage > 1) { %>
                            <a href="/admin/reviews?search=<%= filters.search %>&rating=<%= filters.rating %>&flagStatus=<%= filters.flagStatus %>&sort=<%= filters.sort %>&page=<%= currentPage - 1 %>" class="px-3 py-1.5 bg-sidebar-bg border border-input-dark-border hover:bg-border-dark text-white font-semibold rounded-lg transition-colors">
                                <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                            </a>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/reviews?search=<%= filters.search %>&rating=<%= filters.rating %>&flagStatus=<%= filters.flagStatus %>&sort=<%= filters.sort %>&page=<%= currentPage + 1 %>" class="px-3 py-1.5 bg-sidebar-bg border border-input-dark-border hover:bg-border-dark text-white font-semibold rounded-lg transition-colors">
                                Next <i class="fa-solid fa-chevron-right ml-1"></i>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </main>
</div>

<!-- Modal for Flagging Review as Spam/Fraud -->
<div id="flagModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-card-bg border border-input-dark-border rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
        <h3 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
            <i class="fa-solid fa-flag text-pixel-red"></i> Flag Review for Moderation
        </h3>
        <p class="text-xs text-gray-400 mb-4">Mark this review as spam, fraudulent, or inappropriate for administrative oversight.</p>

        <form id="flagForm" onsubmit="submitFlagModal(event)">
            <input type="hidden" id="modalReviewId" value="" />

            <div class="mb-4">
                <label class="block text-xs font-semibold text-gray-300 mb-1">Flag Reason</label>
                <select id="modalFlagReason" class="w-full bg-sidebar-bg border border-input-dark-border text-white text-xs rounded-lg p-2.5 focus:border-pixel-blue focus:outline-none" required>
                    <option value="Spam">Spam</option>
                    <option value="Fraud / Fake Review">Fraud / Fake Review</option>
                    <option value="Inappropriate Content">Inappropriate Content</option>
                    <option value="Abusive Language">Abusive Language</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="mb-6">
                <label class="block text-xs font-semibold text-gray-300 mb-1">Admin Moderation Notes (Optional)</label>
                <textarea id="modalFlagNotes" rows="3" class="w-full bg-sidebar-bg border border-input-dark-border text-white text-xs rounded-lg p-2.5 focus:border-pixel-blue focus:outline-none placeholder-gray-500" placeholder="Internal notes on why this review was flagged..."></textarea>
            </div>

            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeFlagModal()" class="px-4 py-2 bg-sidebar-bg text-gray-300 hover:text-white rounded-lg text-xs font-semibold border border-input-dark-border transition-colors">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-pixel-red hover:bg-red-600 text-white rounded-lg text-xs font-bold transition-colors flex items-center gap-1.5 shadow-lg">
                    <i class="fa-solid fa-flag"></i> Confirm Flag
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openFlagModal(reviewId, isCurrentlyFlagged, currentReason, currentNotes) {
        document.getElementById('modalReviewId').value = reviewId;
        document.getElementById('modalFlagReason').value = currentReason || 'Spam';
        document.getElementById('modalFlagNotes').value = currentNotes || '';
        document.getElementById('flagModal').classList.remove('hidden');
    }

    function closeFlagModal() {
        document.getElementById('flagModal').classList.add('hidden');
    }

    async function submitFlagModal(e) {
        e.preventDefault();
        const reviewId = document.getElementById('modalReviewId').value;
        const flagReason = document.getElementById('modalFlagReason').value;
        const flagNotes = document.getElementById('modalFlagNotes').value;

        try {
            const res = await fetch(`/admin/reviews/${reviewId}/flag`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isFlagged: true, flagReason, flagNotes })
            });
            const data = await res.json();

            if (data.success) {
                Swal.fire({
                    title: 'Flagged!',
                    text: data.message,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false,
                    background: '#16181d',
                    color: '#fff'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({ title: 'Error', text: data.message, icon: 'error', background: '#16181d', color: '#fff' });
            }
        } catch (err) {
            console.error('Flag error:', err);
        }
    }

    async function unflagReview(reviewId) {
        try {
            const res = await fetch(`/admin/reviews/${reviewId}/flag`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isFlagged: false })
            });
            const data = await res.json();

            if (data.success) {
                Swal.fire({
                    title: 'Unflagged',
                    text: data.message,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false,
                    background: '#16181d',
                    color: '#fff'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({ title: 'Error', text: data.message, icon: 'error', background: '#16181d', color: '#fff' });
            }
        } catch (err) {
            console.error('Unflag error:', err);
        }
    }

    async function deleteReviewAdmin(reviewId) {
        const confirmRes = await Swal.fire({
            title: 'Delete Review?',
            text: 'This will permanently delete the review and recalculate product storefront ratings.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel',
            background: '#16181d',
            color: '#fff',
            confirmButtonColor: '#f92a40',
            cancelButtonColor: '#2d3139'
        });

        if (!confirmRes.isConfirmed) return;

        try {
            const res = await fetch(`/admin/reviews/${reviewId}`, {
                method: 'DELETE'
            });
            const data = await res.json();

            if (data.success) {
                Swal.fire({
                    title: 'Deleted',
                    text: data.message,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false,
                    background: '#16181d',
                    color: '#fff'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({ title: 'Error', text: data.message, icon: 'error', background: '#16181d', color: '#fff' });
            }
        } catch (err) {
            console.error('Delete review error:', err);
        }
    }
</script>

<%- include('../partials/admin/footer') %>

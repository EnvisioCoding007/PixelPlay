    <!-- Toast Notifications Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-[100] flex flex-col gap-3"></div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Modal references
            const addModal = document.getElementById('add-address-modal');
            const editModal = document.getElementById('edit-address-modal');
            const addBtn = document.getElementById('open-add-modal-btn');
            const closeBtns = document.querySelectorAll('.close-modal-btn');
            const editCloseBtns = document.querySelectorAll('.edit-close-modal-btn');

            // Forms references
            const addForm = document.getElementById('add-address-form');
            const editForm = document.getElementById('edit-address-form');

            // Error displays
            const addError = document.getElementById('add-error');
            const editError = document.getElementById('edit-error');

            // Toast display elements
            const toastContainer = document.getElementById('toast-container');

            function showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.className = `flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg border text-sm transition-all duration-300 transform translate-y-2 opacity-0 ${
                    type === 'success' 
                        ? 'bg-[#072412] text-green-400 border-green-500/30' 
                        : 'bg-[#2a080c] text-red-400 border-red-500/30'
                }`;
                toast.innerHTML = `<span>${message}</span>`;
                toastContainer.appendChild(toast);
                
                setTimeout(() => {
                    toast.classList.remove('translate-y-2', 'opacity-0');
                }, 10);
                
                setTimeout(() => {
                    toast.classList.add('opacity-0', 'translate-y-2');
                    setTimeout(() => {
                        toast.remove();
                    }, 300);
                }, 3000);
            }

            // Open Add Modal
            if (addBtn) {
                addBtn.addEventListener('click', () => {
                    addForm.reset();
                    addError.classList.add('hidden');
                    addModal.classList.remove('hidden');
                    addModal.classList.add('flex');
                    document.body.classList.add('overflow-hidden');
                });
            }

            // Close modals
            closeBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    addModal.classList.add('hidden');
                    addModal.classList.remove('flex');
                    document.body.classList.remove('overflow-hidden');
                });
            });

            editCloseBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    editModal.classList.add('hidden');
                    editModal.classList.remove('flex');
                    document.body.classList.remove('overflow-hidden');
                });
            });

            // Close modal on background click
            addModal.addEventListener('click', (e) => {
                if (e.target === addModal) {
                    addModal.classList.add('hidden');
                    addModal.classList.remove('flex');
                    document.body.classList.remove('overflow-hidden');
                }
            });

            editModal.addEventListener('click', (e) => {
                if (e.target === editModal) {
                    editModal.classList.add('hidden');
                    editModal.classList.remove('flex');
                    document.body.classList.remove('overflow-hidden');
                }
            });

            // Close modal on escape key
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    addModal.classList.add('hidden');
                    addModal.classList.remove('flex');
                    editModal.classList.add('hidden');
                    editModal.classList.remove('flex');
                    document.body.classList.remove('overflow-hidden');
                }
            });

            // Populate and open edit modal
            window.openEditModal = function(address) {
                editError.classList.add('hidden');
                
                document.getElementById('edit-id').value = address._id || '';
                document.getElementById('edit-fullName').value = address.fullName || '';
                document.getElementById('edit-phone').value = address.phone || '';
                document.getElementById('edit-addressLine1').value = address.addressLine1 || '';
                document.getElementById('edit-addressLine2').value = address.addressLine2 || '';
                document.getElementById('edit-city').value = address.city || '';
                document.getElementById('edit-state').value = address.state || '';
                document.getElementById('edit-postal_code').value = address.postal_code || '';
                document.getElementById('edit-country').value = address.country || 'India';
                document.getElementById('edit-address_type').value = address.address_type || 'home';
                document.getElementById('edit-isDefault').checked = address.isDefault === true || address.isDefault === 'true';

                editModal.classList.remove('hidden');
                editModal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
            };

            // Setup edit button click handlers
            const editButtons = document.querySelectorAll('.edit-address-btn');
            editButtons.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation(); // prevent selecting the card when clicking edit
                    const rawAttr = btn.getAttribute('data-address');
                    const addressData = JSON.parse(rawAttr.includes('%') ? decodeURIComponent(rawAttr) : rawAttr);
                    openEditModal(addressData);
                });
            });

            // Form validation helper
            function validateAddressForm(form, errorDiv) {
                const fullName = form.querySelector('[name="fullName"]').value.trim();
                const phone = form.querySelector('[name="phone"]').value.trim();
                const addressLine1 = form.querySelector('[name="addressLine1"]').value.trim();
                const city = form.querySelector('[name="city"]').value.trim();
                const state = form.querySelector('[name="state"]').value.trim();
                const postal_code = form.querySelector('[name="postal_code"]').value.trim();
                const country = form.querySelector('[name="country"]').value.trim();

                if (!fullName || !phone || !addressLine1 || !city || !state || !postal_code || !country) {
                    errorDiv.textContent = 'Please fill in all required fields marked with *';
                    errorDiv.classList.remove('hidden');
                    return false;
                }

                const fullNameRegex = /^[a-zA-Z][a-zA-Z ]{1,49}$/;
                if (!fullNameRegex.test(fullName)) {
                    errorDiv.textContent = 'Full name must be 2-50 characters long and contain only letters and spaces';
                    errorDiv.classList.remove('hidden');
                    return false;
                }

                const cleanPhone = phone.replace(/[\s-]/g, '');
                const phoneRegex = /^(?:\+91|91|0)?[6-9]\d{9}$/;
                if (!phoneRegex.test(cleanPhone)) {
                    errorDiv.textContent = 'Please enter a valid phone number (10 to 12 digits, optional +91)';
                    errorDiv.classList.remove('hidden');
                    return false;
                }

                if (!/^\d{6}$/.test(postal_code)) {
                    errorDiv.textContent = 'Postal code must be exactly 6 digits';
                    errorDiv.classList.remove('hidden');
                    return false;
                }

                errorDiv.classList.add('hidden');
                return {
                    fullName,
                    phone,
                    addressLine1,
                    addressLine2: form.querySelector('[name="addressLine2"]').value.trim(),
                    city,
                    state,
                    postal_code: postal_code,
                    country,
                    address_type: form.querySelector('[name="address_type"]').value,
                    isDefault: form.querySelector('[name="isDefault"]').checked
                };
            }

            // Save Address Submit
            addForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const payload = validateAddressForm(addForm, addError);
                if (!payload) return;

                try {
                    const response = await fetch('/profile/addresses', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();
                    if (response.ok && data.success) {
                        showToast(data.message || 'Address added successfully.');
                        addModal.classList.add('hidden');
                        addModal.classList.remove('flex');
                        document.body.classList.remove('overflow-hidden');
                        setTimeout(() => {
                            location.reload();
                        }, 800);
                    } else {
                        addError.textContent = data.message || 'Failed to add address.';
                        addError.classList.remove('hidden');
                    }
                } catch (err) {
                    addError.textContent = 'Network error. Please try again.';
                    addError.classList.remove('hidden');
                }
            });

            // Update Address Submit
            editForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const payload = validateAddressForm(editForm, editError);
                if (!payload) return;
                
                const addressId = document.getElementById('edit-id').value;

                try {
                    const response = await fetch(`/profile/addresses/${addressId}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();
                    if (response.ok && data.success) {
                        showToast(data.message || 'Address updated successfully.');
                        editModal.classList.add('hidden');
                        editModal.classList.remove('flex');
                        document.body.classList.remove('overflow-hidden');
                        setTimeout(() => {
                            location.reload();
                        }, 800);
                    } else {
                        editError.textContent = data.message || 'Failed to update address.';
                        editError.classList.remove('hidden');
                    }
                } catch (err) {
                    editError.textContent = 'Network error. Please try again.';
                    editError.classList.remove('hidden');
                }
            });

            const addressCards = document.querySelectorAll('.address-card');
            addressCards.forEach(card => {
                card.addEventListener('click', () => {
                    // Deselect all cards
                    addressCards.forEach(c => {
                        c.classList.remove('border-cyber-blue', 'bg-cyber-blue/5');
                        c.classList.add('border-dark-border', 'bg-dark-surface', 'opacity-70');
                        
                        // Update header text color
                        const header = c.querySelector('.text-cyber-blue, .text-\\[\\#c084fc\\]');
                        if (header) {
                            header.classList.remove('text-cyber-blue');
                            header.classList.add('text-[#c084fc]');
                        }
                        
                        // Update circle icon
                        const indicator = c.querySelector('.select-indicator');
                        if (indicator) {
                            indicator.className = 'select-indicator fa-regular fa-circle';
                        }
                        
                        // Hide badge
                        const badge = c.querySelector('.primary-badge');
                        if (badge) {
                            badge.classList.add('hidden');
                        }
                    });
                    
                    // Select clicked card
                    card.classList.remove('border-dark-border', 'bg-dark-surface', 'opacity-70');
                    card.classList.add('border-cyber-blue', 'bg-cyber-blue/5');
                    
                    // Update header text color
                    const header = card.querySelector('.text-cyber-blue, .text-\\[\\#c084fc\\]');
                    if (header) {
                        header.classList.remove('text-[#c084fc]');
                        header.classList.add('text-cyber-blue');
                    }
                    
                    // Update circle icon
                    const indicator = card.querySelector('.select-indicator');
                    if (indicator) {
                        indicator.className = 'select-indicator fa-regular fa-circle-dot';
                    }
                    
                    // Show badge
                    const badge = card.querySelector('.primary-badge');
                    if (badge) {
                        badge.classList.remove('hidden');
                    }
                    
                    // Auto-fill phone number field from selected address
                    const cardPhone = card.getAttribute('data-phone');
                    const phoneInput = document.getElementById('checkout-phone');
                    if (phoneInput && cardPhone !== null) {
                        phoneInput.value = cardPhone;
                    }

                    // Optional: Store selected address ID in a variable or input
                    const addressId = card.getAttribute('data-address-id');
                    console.log('Selected Address ID:', addressId);
                });
            });

            // Payment method tab toggling
            const cardFormContainer = document.getElementById('card-form-container');
            const addressLabelText = document.getElementById('address-label-text');
            const submitPayBtn = document.getElementById('submit-pay-btn');
            const razorpaySecureBadge = document.getElementById('razorpay-secure-badge');
            const encryptedChannelBadge = document.getElementById('encrypted-channel-badge');

            // Coupon state & AJAX logic
            let currentAppliedCouponCode = '<%= cart.appliedCoupon ? cart.appliedCoupon.code : "" %>';
            const bestCouponCode = '<%= bestCoupon ? bestCoupon.code : "" %>';

            function updateOrderLedger(cartDetails) {
                if (!cartDetails) return;

                const subtotalDisplay = document.getElementById('summary-subtotal-display');
                const taxDisplay = document.getElementById('summary-tax-display');
                const shippingDisplay = document.getElementById('summary-shipping-display');
                const grandTotalDisplay = document.getElementById('summary-grand-total-display');
                const discountRow = document.getElementById('summary-discount-row');
                const discountDisplay = document.getElementById('summary-discount-display');
                const couponCodeTag = document.getElementById('summary-coupon-code-tag');
                const appliedPill = document.getElementById('applied-coupon-pill');
                const appliedCodeText = document.getElementById('applied-code-text');
                const appliedSavingsText = document.getElementById('applied-savings-text');
                const manualInput = document.getElementById('manual-coupon-input');
                const autoNoticeHeader = document.getElementById('coupon-auto-notice-header');
                const autoCodeText = document.getElementById('auto-coupon-code-text');
                const autoSavingsText = document.getElementById('auto-coupon-savings-text');

                // 1. Update Order Summary breakdown numbers
                if (subtotalDisplay) subtotalDisplay.innerText = `₹${cartDetails.subtotalRupees || '0.00'}`;
                if (taxDisplay) taxDisplay.innerText = `₹${cartDetails.taxRupees || '0.00'}`;
                if (shippingDisplay) shippingDisplay.innerText = `₹${cartDetails.shippingRupees || '0.00'}`;
                if (grandTotalDisplay) grandTotalDisplay.innerText = `₹${cartDetails.grandTotalRupees || '0.00'}`;

                // 2. Update Applied Coupon pill and discount row in order summary
                if (cartDetails.appliedCoupon && (cartDetails.discount > 0 || (cartDetails.appliedCoupon.discountValue && cartDetails.appliedCoupon.discountValue > 0))) {
                    currentAppliedCouponCode = (cartDetails.appliedCoupon.code || '').trim().toUpperCase();
                    if (discountRow) discountRow.classList.remove('hidden');
                    if (discountDisplay) discountDisplay.innerText = `-₹${cartDetails.discountRupees || '0.00'}`;
                    if (couponCodeTag) couponCodeTag.innerText = currentAppliedCouponCode;

                    if (appliedPill) appliedPill.classList.remove('hidden');
                    if (appliedCodeText) appliedCodeText.innerText = currentAppliedCouponCode;
                    if (appliedSavingsText) appliedSavingsText.innerText = cartDetails.discountRupees || '0.00';
                    if (manualInput) manualInput.value = currentAppliedCouponCode;

                    if (bestCouponCode && currentAppliedCouponCode === bestCouponCode.toUpperCase() && autoNoticeHeader) {
                        autoNoticeHeader.classList.remove('hidden');
                        if (autoCodeText) autoCodeText.innerText = currentAppliedCouponCode;
                        if (autoSavingsText) autoSavingsText.innerText = cartDetails.discountRupees || '0.00';
                    } else if (autoNoticeHeader) {
                        autoNoticeHeader.classList.add('hidden');
                    }
                } else {
                    currentAppliedCouponCode = '';
                    if (discountRow) discountRow.classList.add('hidden');
                    if (appliedPill) appliedPill.classList.add('hidden');
                    if (manualInput) manualInput.value = '';
                    if (autoNoticeHeader) autoNoticeHeader.classList.add('hidden');
                }

                // 3. Update Pay Button text
                if (submitPayBtn) {
                    if (activePaymentMethod === 'COD') {
                        submitPayBtn.innerText = 'Place Order';
                    } else {
                        submitPayBtn.innerText = `Pay ₹${cartDetails.grandTotalRupees || '0.00'}`;
                    }
                }

                // 4. Update Coupon Cards: Global Reset followed by targeted activation
                const cards = document.querySelectorAll('.coupon-card');
                const baseClasses = "coupon-card p-3.5 rounded-lg border flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all";

                // Step A: Global reset of ALL coupon cards to default inactive state
                cards.forEach(card => {
                    const cardCode = (card.getAttribute('data-code') || '').trim().toUpperCase();
                    card.className = `${baseClasses} border-dark-border bg-dark-surface hover:border-cyber-blue/40`;
                    
                    const actionContainer = card.querySelector('.coupon-action-container') || card.querySelector('.shrink-0:last-child');
                    if (actionContainer) {
                        actionContainer.innerHTML = `
                            <button type="button" class="apply-coupon-card-btn px-4 py-1.5 bg-cyber-blue hover:bg-blue-400 text-black font-bold text-xs rounded-lg transition-colors cursor-pointer" data-code="${cardCode}">
                                Apply
                            </button>
                        `;
                    }
                });

                // Step B: Dynamically toggle active state ONLY on the newly applied coupon card
                if (currentAppliedCouponCode) {
                    cards.forEach(card => {
                        const cardCode = (card.getAttribute('data-code') || '').trim().toUpperCase();
                        if (cardCode === currentAppliedCouponCode) {
                            card.className = `${baseClasses} border-cyber-green bg-cyber-green/5`;
                            const actionContainer = card.querySelector('.coupon-action-container') || card.querySelector('.shrink-0:last-child');
                            if (actionContainer) {
                                actionContainer.innerHTML = `
                                    <span class="applied-badge px-3.5 py-1.5 bg-cyber-green/20 text-cyber-green border border-cyber-green/40 rounded-lg text-xs font-bold flex items-center gap-1.5">
                                        <i class="fa-solid fa-check"></i> Applied
                                    </span>
                                `;
                            }
                        }
                    });
                }
            }

            async function applyCouponCode(code) {
                if (!code || !code.trim()) {
                    showToast('Please enter a coupon code.', 'error');
                    return;
                }

                try {
                    const response = await fetch('/cart/apply-coupon', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ couponCode: code.trim() })
                    });
                    const data = await response.json();
                    if (response.ok && data.success) {
                        showToast(data.message, 'success');
                        updateOrderLedger(data.cartDetails);
                    } else {
                        showToast(data.message || 'Failed to apply coupon.', 'error');
                    }
                } catch (err) {
                    showToast('Network error while applying coupon.', 'error');
                }
            }

            async function removeCouponCode() {
                try {
                    const response = await fetch('/cart/remove-coupon', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await response.json();
                    if (response.ok && data.success) {
                        showToast('Coupon removed.', 'success');
                        updateOrderLedger(data.cartDetails);
                    } else {
                        showToast(data.message || 'Failed to remove coupon.', 'error');
                    }
                } catch (err) {
                    showToast('Network error while removing coupon.', 'error');
                }
            }

            // Event delegation for coupon apply buttons
            const eligibleContainer = document.getElementById('eligible-coupons-container');
            if (eligibleContainer) {
                eligibleContainer.addEventListener('click', (e) => {
                    const btn = e.target.closest('.apply-coupon-card-btn');
                    if (btn) {
                        const code = btn.getAttribute('data-code');
                        if (code) applyCouponCode(code);
                    }
                });
            }

            const applyManualBtn = document.getElementById('apply-manual-coupon-btn');
            if (applyManualBtn) {
                applyManualBtn.addEventListener('click', () => {
                    const input = document.getElementById('manual-coupon-input');
                    if (input) applyCouponCode(input.value);
                });
            }

            const removeBtn = document.getElementById('remove-coupon-btn');
            if (removeBtn) {
                removeBtn.addEventListener('click', removeCouponCode);
            }

            const tabs = {
                'tab-online': {
                    method: 'Online',
                    addressLabel: "BILLING ADDRESS",
                    showOnlineInfo: true,
                    showWalletInfo: false,
                    showRazorpay: true,
                    showEncrypted: true
                },
                'tab-cod': {
                    method: 'COD',
                    addressLabel: "DELIVERY ADDRESS",
                    showOnlineInfo: false,
                    showWalletInfo: false,
                    showRazorpay: false,
                    showEncrypted: false
                },
                'tab-wallet': {
                    method: 'PixelWallet',
                    addressLabel: "BILLING ADDRESS",
                    showOnlineInfo: false,
                    showWalletInfo: true,
                    showRazorpay: false,
                    showEncrypted: false
                }
            };

            let activePaymentMethod = 'Online'; // default
            const userWalletBalance = <%= userWalletBal %>;

            Object.keys(tabs).forEach(tabId => {
                const tabEl = document.getElementById(tabId);
                if (tabEl) {
                    tabEl.addEventListener('click', () => {
                        const config = tabs[tabId];
                        activePaymentMethod = config.method;

                        const walletInfoContainer = document.getElementById('wallet-info-container');
                        const onlineInfoContainer = document.getElementById('online-info-container');

                        if (config.showWalletInfo && walletInfoContainer) walletInfoContainer.classList.remove('hidden');
                        else if (walletInfoContainer) walletInfoContainer.classList.add('hidden');

                        if (config.showOnlineInfo && onlineInfoContainer) onlineInfoContainer.classList.remove('hidden');
                        else if (onlineInfoContainer) onlineInfoContainer.classList.add('hidden');

                        if (config.showRazorpay) razorpaySecureBadge.classList.remove('hidden');
                        else razorpaySecureBadge.classList.add('hidden');

                        if (config.showEncrypted) encryptedChannelBadge.classList.remove('hidden');
                        else encryptedChannelBadge.classList.add('hidden');

                        addressLabelText.innerText = config.addressLabel;

                        const grandTotalText = document.getElementById('summary-grand-total-display')?.innerText || '₹<%= (cart.grandTotal / 100).toFixed(2) %>';
                        if (activePaymentMethod === 'COD') {
                            submitPayBtn.innerText = 'Place Order';
                        } else if (activePaymentMethod === 'PixelWallet') {
                            submitPayBtn.innerText = `Pay ${grandTotalText} with PixelWallet`;
                        } else {
                            submitPayBtn.innerText = `Pay ${grandTotalText} with Razorpay`;
                        }

                        // Update tab styles
                        Object.keys(tabs).forEach(id => {
                            const el = document.getElementById(id);
                            if (el) {
                                if (id === tabId) {
                                    el.classList.remove('border-transparent', 'text-text-secondary', 'hover:text-white');
                                    el.classList.add('border-cyber-blue', 'text-cyber-blue', 'bg-cyber-blue/10');
                                } else {
                                    el.classList.remove('border-cyber-blue', 'text-cyber-blue', 'bg-cyber-blue/10');
                                    el.classList.add('border-transparent', 'text-text-secondary', 'hover:text-white');
                                }
                            }
                        });
                    });
                }
            });

            // Submit Payment / Place Order
            if (submitPayBtn) {
                submitPayBtn.addEventListener('click', async () => {
                    const phoneInput = document.getElementById('checkout-phone');
                    const phoneVal = phoneInput ? phoneInput.value.trim() : '';
                    const cleanPhone = phoneVal.replace(/[\s-]/g, '');
                    const phoneRegex = /^(?:\+91|91|0)?[6-9]\d{9}$/;
                    if (!phoneVal || !phoneRegex.test(cleanPhone)) {
                        showToast('Please enter a valid phone number (10 to 12 digits, optional +91) in Contact Information.', 'error');
                        return;
                    }

                    const selectedAddressCard = document.querySelector('.address-card.border-cyber-blue');
                    if (!selectedAddressCard) {
                        showToast('Please select a delivery address.', 'error');
                        return;
                    }
                    const addressId = selectedAddressCard.getAttribute('data-address-id');

                    if (activePaymentMethod === 'Online') {
                        // Razorpay Online Payment Flow
                        submitPayBtn.disabled = true;
                        submitPayBtn.innerText = 'Initiating Secure Payment...';

                        try {
                            const createRes = await fetch('/orders/razorpay-create', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    addressId,
                                    couponCode: currentAppliedCouponCode
                                })
                            });

                            const createData = await createRes.json();
                            if (!createRes.ok || !createData.success) {
                                const isCouponError = createData.isCouponExpired || (createData.message && (createData.message.toLowerCase().includes('coupon') || createData.message.toLowerCase().includes('expired')));
                                if (isCouponError) {
                                    await Swal.fire({
                                        icon: 'error',
                                        title: 'Coupon Expired',
                                        text: createData.message || 'The applied coupon has expired or is no longer valid.',
                                        confirmButtonText: 'Update Order',
                                        confirmButtonColor: '#00b0ff',
                                        allowOutsideClick: false
                                    });
                                    try {
                                        await removeCouponCode();
                                    } catch (_) {}
                                    window.location.href = '/checkout';
                                    return;
                                }

                                showToast(createData.message || 'Failed to initiate online payment.', 'error');
                                submitPayBtn.disabled = false;
                                const grandTotalText = document.getElementById('summary-grand-total-display')?.innerText || '';
                                submitPayBtn.innerText = `Pay ${grandTotalText} with Razorpay`;
                                return;
                            }

                            // Launch Razorpay Checkout Modal
                            const options = {
                                key: createData.razorpayKeyId,
                                amount: createData.amount,
                                currency: createData.currency || 'INR',
                                name: 'PixelPlay',
                                description: 'Game Order Purchase',
                                order_id: createData.razorpayOrderId,
                                handler: async function (response) {
                                    submitPayBtn.disabled = true;
                                    submitPayBtn.innerText = 'Verifying Payment...';
                                    try {
                                        const verifyRes = await fetch('/orders/razorpay-verify', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({
                                                addressId,
                                                couponCode: currentAppliedCouponCode,
                                                razorpay_order_id: response.razorpay_order_id,
                                                razorpay_payment_id: response.razorpay_payment_id,
                                                razorpay_signature: response.razorpay_signature
                                            })
                                        });

                                        const verifyData = await verifyRes.json();
                                        if (verifyRes.ok && verifyData.success) {
                                            showToast(verifyData.message || 'Payment successful!', 'success');
                                            setTimeout(() => {
                                                window.location.href = `/orders/success/${verifyData.orderId}`;
                                            }, 800);
                                        } else {
                                            window.location.href = `/checkout/failure?reason=${encodeURIComponent(verifyData.message || 'Payment verification failed')}`;
                                        }
                                    } catch (err) {
                                        window.location.href = `/checkout/failure?reason=${encodeURIComponent('Network error during verification')}`;
                                    }
                                },
                                prefill: {
                                    name: '<%= user ? (user.username || "") : "" %>',
                                    email: '<%= user ? (user.email || "") : "" %>',
                                    contact: cleanPhone
                                },
                                theme: { color: '#00b0ff' },
                                modal: {
                                    ondismiss: function () {
                                        window.location.href = `/checkout/failure?reason=${encodeURIComponent('Payment window closed by user before completing transaction')}`;
                                    }
                                }
                            };

                            const rzp = new Razorpay(options);
                            rzp.open();
                        } catch (err) {
                            showToast('Network error while initiating payment.', 'error');
                            submitPayBtn.disabled = false;
                            const grandTotalText = document.getElementById('summary-grand-total-display')?.innerText || '';
                            submitPayBtn.innerText = `Pay ${grandTotalText} with Razorpay`;
                        }
                    } else if (activePaymentMethod === 'PixelWallet') {
                        // PixelWallet Order Flow
                        const displayTotalText = document.getElementById('summary-grand-total-display')?.innerText || '';
                        const parsedRupees = parseFloat(displayTotalText.replace(/[^0-9.]/g, ''));
                        const currentGrandTotalPaisa = (!isNaN(parsedRupees) && parsedRupees > 0) ? Math.round(parsedRupees * 100) : <%= cart.grandTotal %>;

                        if (userWalletBalance < currentGrandTotalPaisa) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Insufficient PixelWallet Balance',
                                html: `Your PixelWallet balance (₹${(userWalletBalance/100).toFixed(2)}) is lower than order total (₹${(currentGrandTotalPaisa/100).toFixed(2)}). Please recharge your wallet to proceed.`,
                                showCancelButton: true,
                                confirmButtonText: '<i class="fa-solid fa-plus-circle"></i> Recharge PixelWallet',
                                confirmButtonColor: '#00b0ff',
                                cancelButtonText: 'Cancel'
                            }).then((res) => {
                                if (res.isConfirmed) {
                                    window.location.href = '/wallet';
                                }
                            });
                            return;
                        }

                        submitPayBtn.disabled = true;
                        submitPayBtn.innerText = 'Processing Order...';

                        try {
                            const response = await fetch('/orders', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ 
                                    paymentMethod: 'PixelWallet', 
                                    addressId,
                                    couponCode: currentAppliedCouponCode
                                })
                            });

                            const data = await response.json();
                            if (response.ok && data.success) {
                                showToast(data.message || 'Order placed successfully.');
                                setTimeout(() => {
                                    window.location.href = `/orders/success/${data.orderId}`;
                                }, 800);
                            } else {
                                const isCouponError = data.isCouponExpired || (data.message && (data.message.toLowerCase().includes('coupon') || data.message.toLowerCase().includes('expired')));
                                if (isCouponError) {
                                    await Swal.fire({
                                        icon: 'error',
                                        title: 'Coupon Expired',
                                        text: data.message || 'The applied coupon has expired or is no longer valid.',
                                        confirmButtonText: 'Update Order',
                                        confirmButtonColor: '#00b0ff',
                                        allowOutsideClick: false
                                    });
                                    try {
                                        await removeCouponCode();
                                    } catch (_) {}
                                    window.location.href = '/checkout';
                                    return;
                                }

                                showToast(data.message || 'Failed to place order using PixelWallet.', 'error');
                                submitPayBtn.disabled = false;
                                const grandTotalText = document.getElementById('summary-grand-total-display')?.innerText || '';
                                submitPayBtn.innerText = `Pay ${grandTotalText} with PixelWallet`;
                            }
                        } catch (err) {
                            showToast('Network error. Please try again.', 'error');
                            submitPayBtn.disabled = false;
                            const grandTotalText = document.getElementById('summary-grand-total-display')?.innerText || '';
                            submitPayBtn.innerText = `Pay ${grandTotalText} with PixelWallet`;
                        }
                    } else {
                        // COD Order Flow
                        submitPayBtn.disabled = true;
                        submitPayBtn.innerText = 'Processing Order...';

                        try {
                            const response = await fetch('/orders', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ 
                                    paymentMethod: 'COD', 
                                    addressId,
                                    couponCode: currentAppliedCouponCode
                                })
                            });

                            const data = await response.json();
                            if (response.ok && data.success) {
                                showToast(data.message || 'Order placed successfully.');
                                setTimeout(() => {
                                    window.location.href = `/orders/success/${data.orderId}`;
                                }, 800);
                            } else {
                                const isCouponError = data.isCouponExpired || (data.message && (data.message.toLowerCase().includes('coupon') || data.message.toLowerCase().includes('expired')));
                                if (isCouponError) {
                                    await Swal.fire({
                                        icon: 'error',
                                        title: 'Coupon Expired',
                                        text: data.message || 'The applied coupon has expired or is no longer valid.',
                                        confirmButtonText: 'Update Order',
                                        confirmButtonColor: '#00b0ff',
                                        allowOutsideClick: false
                                    });
                                    try {
                                        await removeCouponCode();
                                    } catch (_) {}
                                    window.location.href = '/checkout';
                                    return;
                                }

                                showToast(data.message || 'Failed to place order.', 'error');
                                submitPayBtn.disabled = false;
                                submitPayBtn.innerText = 'Place Order';
                            }
                        } catch (err) {
                            showToast('Network error. Please try again.', 'error');
                            submitPayBtn.disabled = false;
                            submitPayBtn.innerText = 'Place Order';
                        }
                    }
                });
            }
        });
    </script>
</body>

</html>
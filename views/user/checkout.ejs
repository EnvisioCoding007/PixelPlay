<!DOCTYPE html>

<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Payment Details Checkout</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'dark-bg': '#0a0d14',
                        'dark-surface': '#11151c',
                        'dark-surface-2': '#171b22',
                        'dark-border': '#222730',
                        'cyber-blue': '#00b0ff',
                        'cyber-green': '#00e676',
                        'text-primary': '#e2e8f0',
                        'text-secondary': '#94a3b8',
                        'text-tertiary': '#64748b'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace']
                    }
                }
            }
        }
    </script>
    <style data-purpose="custom-styles" type="text/tailwindcss">
        @layer utilities {
      .glass-panel {
        @apply bg-dark-surface/80 backdrop-blur-md border border-dark-border;
      }
      .cyber-input {
        @apply bg-dark-surface-2 border border-dark-border text-text-primary rounded-md focus:border-cyber-blue focus:ring-1 focus:ring-cyber-blue outline-none transition-colors;
      }
    }
    body {
      background: radial-gradient(circle at top right, #0d121a 0%, #05070a 100%);
    }
  </style>
</head>

<body
    class="bg-dark-bg text-text-primary min-h-screen font-sans antialiased overflow-x-hidden p-4 sm:p-6 lg:p-8 flex justify-center items-start">
    <!-- BEGIN: Checkout Container -->
    <div class="w-full max-w-[1400px] mx-auto flex flex-col lg:flex-row gap-8 lg:gap-10 xl:gap-12 relative">
        <!-- Close Button -->
        <a href="/cart"
            class="absolute top-0 right-0 text-text-secondary hover:text-white p-2 z-50 text-xl transition-colors"
            title="Return to Cart">
            <i class="fa-solid fa-xmark"></i>
        </a>
        <!-- BEGIN: Left Column (Payment Details) -->
        <div class="flex-1 w-full flex flex-col gap-8 min-w-0">
            <!-- Header -->
            <div>
                <a href="/cart" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-text-secondary hover:text-cyber-blue transition-colors mb-2">
                    <i class="fa-solid fa-arrow-left"></i> Return to Cart
                </a>
                <h1 class="text-2xl sm:text-3xl font-bold mb-1">Payment Details</h1>
                <p class="text-text-secondary text-sm">Complete your purchase to add the game to your library.</p>
            </div>
            <!-- Payment Method Tabs -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm font-medium">
                <button id="tab-online" type="button"
                    class="px-4 py-3 rounded-lg border border-cyber-blue text-cyber-blue bg-cyber-blue/10 flex items-center justify-center gap-2 transition-all duration-200 cursor-pointer whitespace-nowrap">
                    <i class="fa-solid fa-credit-card"></i> Online Payment
                </button>
                <button id="tab-cod" type="button"
                    class="px-4 py-3 rounded-lg border border-transparent text-text-secondary hover:text-white hover:bg-dark-surface-2 flex items-center justify-center gap-2 transition-all duration-200 cursor-pointer whitespace-nowrap">
                    <i class="fa-solid fa-money-bill-wave"></i> Cash On Delivery
                </button>
                <button id="tab-wallet" type="button"
                    class="px-4 py-3 rounded-lg border border-transparent text-text-secondary hover:text-white hover:bg-dark-surface-2 flex items-center justify-center gap-2 transition-all duration-200 cursor-pointer whitespace-nowrap">
                    <i class="fa-solid fa-wallet"></i> PixelWallet
                </button>
            </div>
            <%
                let defaultAddressIndex = -1;
                if (user && user.addresses && user.addresses.length > 0) {
                    defaultAddressIndex = user.addresses.findIndex(addr => addr.isDefault);
                    if (defaultAddressIndex === -1) defaultAddressIndex = 0;
                }
                const selectedAddress = (user && user.addresses && user.addresses.length > 0 && defaultAddressIndex !== -1) ? user.addresses[defaultAddressIndex] : null;
                const initialPhone = selectedAddress ? (selectedAddress.phone || user.phone || '') : (user ? (user.phone || '') : '');
                const userWalletBal = typeof walletBalance !== 'undefined' ? walletBalance : 0;
            %>
            <!-- PixelWallet Balance Info Container -->
            <div id="wallet-info-container" class="hidden flex-col gap-3 p-5 rounded-xl border border-dark-border bg-dark-surface-2/80 shadow-lg transition-all">
                <div class="flex items-center justify-between flex-wrap gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <div>
                            <span class="text-xs text-text-tertiary uppercase font-semibold block tracking-wider">PixelWallet Balance</span>
                            <span class="text-lg font-bold font-mono text-white">₹<%= (userWalletBal / 100).toFixed(2) %></span>
                        </div>
                    </div>
                    <% if (userWalletBal >= cart.grandTotal) { %>
                        <span class="px-3 py-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold rounded-lg flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-check"></i> Sufficient Balance
                        </span>
                    <% } else { %>
                        <span class="px-3 py-1 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-bold rounded-lg flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-exclamation"></i> Insufficient Balance
                        </span>
                    <% } %>
                </div>
                <% if (userWalletBal < cart.grandTotal) { %>
                    <div class="text-xs text-rose-400 bg-rose-950/40 border border-rose-500/20 p-4 rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation text-rose-400 text-base shrink-0"></i>
                            <span>Your PixelWallet balance (₹<%= (userWalletBal / 100).toFixed(2) %>) is lower than order total (₹<%= (cart.grandTotal / 100).toFixed(2) %>).</span>
                        </div>
                        <a href="/wallet" class="px-4 py-2 bg-sky-500 hover:bg-sky-400 text-black font-bold text-xs rounded-lg transition-all shadow-md shadow-sky-500/20 whitespace-nowrap shrink-0 flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-plus-circle"></i> Recharge PixelWallet
                        </a>
                    </div>
                <% } else { %>
                    <div class="text-xs text-text-secondary bg-dark-surface p-3 rounded-lg flex items-center gap-2 border border-dark-border">
                        <i class="fa-solid fa-circle-info text-sky-400 shrink-0"></i>
                        <span>Order total (₹<%= (cart.grandTotal / 100).toFixed(2) %>) will be deducted instantly from your PixelWallet. Remaining balance: <strong class="text-white font-mono" id="wallet-remaining-display">₹<%= ((userWalletBal - cart.grandTotal) / 100).toFixed(2) %></strong></span>
                    </div>
                <% } %>
            </div>
            <!-- Online Payment Razorpay Note Container -->
            <div id="online-info-container" class="flex flex-col gap-2 p-4 rounded-xl border border-sky-500/20 bg-sky-500/5 text-xs text-text-secondary">
                <div class="flex items-center gap-2 text-sky-400 font-semibold text-sm">
                    <i class="fa-solid fa-shield-halved"></i> Online Payment via Razorpay
                </div>
                <p>Pay securely using Credit Cards, Debit Cards, Netbanking, or UPI apps (GPay, PhonePe, Paytm). Click <strong>Pay</strong> below to launch the Razorpay Checkout gateway.</p>
            </div>
            <!-- Contact Information -->
            <div class="flex flex-col gap-3">
                <h2 class="font-semibold text-sm">Contact Information</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs text-text-tertiary font-medium mb-1 uppercase tracking-wider">Email Address</label>
                        <input
                            class="w-full bg-dark-surface-2 border border-dark-border rounded-lg p-3 text-sm text-text-primary focus:outline-none opacity-80 cursor-not-allowed"
                            placeholder="Email" type="email" value="<%= user.email %>" readonly />
                    </div>
                    <div>
                        <label class="block text-xs text-text-tertiary font-medium mb-1 uppercase tracking-wider">Phone Number *</label>
                        <input id="checkout-phone" class="w-full bg-dark-surface-2 border border-dark-border rounded-lg p-3 text-sm text-text-primary focus:border-cyber-blue focus:outline-none transition-colors"
                            placeholder="Phone Number" type="text" value="<%= initialPhone %>" />
                    </div>
                </div>
            </div>
            <!-- Billing Address -->
            <div class="flex flex-col gap-3">
                <h2 class="font-semibold text-xs tracking-wider text-text-secondary uppercase flex items-center gap-2">
                    <i class="fa-solid fa-location-dot"></i> <span id="address-label-text">BILLING ADDRESS</span>
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-4">
                    <% if (user.addresses && user.addresses.length > 0) { %>
                        <% user.addresses.forEach((address, index) => { %>
                            <% const isSelected = index === defaultAddressIndex; %>
                            <!-- Address Card -->
                            <div data-address-id="<%= address._id %>"
                                data-phone="<%= address.phone || '' %>"
                                class="address-card rounded-xl border p-4 flex flex-col gap-2 relative cursor-pointer transition-all duration-200 hover:shadow-lg <%= isSelected ? 'border-cyber-blue bg-cyber-blue/5 text-text-primary' : 'border-dark-border bg-dark-surface opacity-70 hover:opacity-100' %>">
                                <div class="flex justify-between items-center text-xs font-semibold <%= isSelected ? 'text-cyber-blue' : 'text-[#c084fc]' %>">
                                    <span class="flex items-center gap-1">
                                        <% if (address.address_type && address.address_type.toLowerCase() === 'home') { %>
                                            <i class="fa-solid fa-house"></i>
                                        <% } else if (address.address_type && address.address_type.toLowerCase() === 'office') { %>
                                            <i class="fa-solid fa-building"></i>
                                        <% } else { %>
                                            <i class="fa-solid fa-location-dot"></i>
                                        <% } %>
                                        <%= address.address_type ? address.address_type.toUpperCase() : 'ADDRESS' %>
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <!-- Edit Address Button -->
                                        <button type="button" class="edit-address-btn text-text-secondary hover:text-white transition-colors p-1" data-address="<%= encodeURIComponent(JSON.stringify(address)) %>">
                                            <i class="fa-solid fa-pen text-[10px]"></i>
                                        </button>
                                        <i class="select-indicator <%= isSelected ? 'fa-regular fa-circle-dot' : 'fa-regular fa-circle' %>"></i>
                                    </div>
                                </div>
                                <div class="text-sm">
                                    <div class="font-semibold mb-1"><%= address.fullName %></div>
                                    <div class="text-text-secondary text-xs leading-relaxed">
                                        <%= address.addressLine1 %><br />
                                        <%= address.city %>, <%= address.state %> — <%= address.postal_code %><br />
                                        India
                                    </div>
                                </div>
                                <div class="mt-auto pt-2 primary-badge <%= isSelected ? '' : 'hidden' %>">
                                    <span class="text-xs text-cyber-blue flex items-center gap-1"><i
                                            class="fa-regular fa-star"></i> Selected Address</span>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                    <!-- Add New Address -->
                    <button type="button" id="open-add-modal-btn"
                        class="rounded-xl border border-dashed border-dark-border bg-dark-surface/50 p-4 flex flex-col items-center justify-center gap-2 cursor-pointer hover:border-cyber-blue hover:text-cyber-blue transition-all duration-200 group text-center min-h-[120px]">
                        <div
                            class="w-8 h-8 rounded-full border border-dark-border flex items-center justify-center text-text-secondary group-hover:border-cyber-blue group-hover:text-cyber-blue transition-colors mx-auto">
                            <i class="fa-solid fa-plus text-xs"></i>
                        </div>
                        <span
                            class="text-xs text-center text-text-secondary font-medium group-hover:text-cyber-blue block mt-1">Add
                            New Address</span>
                    </button>
                </div>
            </div>
            <!-- Coupons & Promos -->
            <div class="flex flex-col gap-4 rounded-xl border border-dark-border bg-[#0d1219]/90 p-5 md:p-6 shadow-lg">
                <!-- Auto-Applied Coupon Notice Header -->
                <div id="coupon-auto-notice-header" class="<%= (typeof autoAppliedCouponCode !== 'undefined' && autoAppliedCouponCode && cart.appliedCoupon) ? '' : 'hidden' %> p-3 bg-cyber-green/10 border border-cyber-green/30 rounded-lg flex items-center justify-between text-xs text-cyber-green">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-sm animate-pulse"></i>
                        <span>Highest savings coupon <strong id="auto-coupon-code-text" class="font-mono text-white uppercase"><%= cart.appliedCoupon ? cart.appliedCoupon.code : '' %></strong> auto-applied (Saved ₹<span id="auto-coupon-savings-text"><%= (cart.discount / 100).toFixed(2) %></span>)</span>
                    </div>
                </div>

                <h2 class="font-semibold text-xs tracking-wider text-cyber-green uppercase flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-ticket"></i> AVAILABLE COUPONS FOR YOUR TERMINAL
                    </span>
                    <% if (typeof eligibleCoupons !== 'undefined' && eligibleCoupons.length > 0) { %>
                        <span class="text-[10px] text-text-secondary bg-dark-surface-2 px-2 py-0.5 rounded border border-dark-border">
                            <%= eligibleCoupons.length %> Eligible
                        </span>
                    <% } %>
                </h2>

                <!-- Eligible Coupons List -->
                <div class="flex flex-col gap-3" id="eligible-coupons-container">
                    <% if (typeof eligibleCoupons !== 'undefined' && eligibleCoupons.length > 0) { %>
                        <% eligibleCoupons.forEach(c => { %>
                            <% const isApplied = cart.appliedCoupon && cart.appliedCoupon.code === c.code; %>
                            <div class="coupon-card p-3.5 rounded-lg border flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all <%= isApplied ? 'border-cyber-green bg-cyber-green/5' : 'border-dark-border bg-dark-surface hover:border-cyber-blue/40' %>" data-code="<%= c.code %>">
                                <div class="flex items-start gap-3">
                                    <div class="w-9 h-9 rounded-lg bg-cyber-blue/10 border border-cyber-blue/20 text-cyber-blue flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">
                                        <i class="fa-solid fa-percent"></i>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="font-mono font-bold text-sm text-white tracking-wider uppercase"><%= c.code %></span>
                                            <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-cyber-blue/20 text-cyber-blue border border-cyber-blue/30"><%= c.discountDisplay %></span>
                                            <% if (bestCoupon && bestCoupon.code === c.code) { %>
                                                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Highest Savings</span>
                                            <% } %>
                                        </div>
                                        <div class="text-xs text-text-secondary mt-1"><%= c.description %></div>
                                        <div class="text-[11px] text-cyber-green font-semibold mt-1">
                                            Save ₹<%= c.discountRupees %> on this order
                                        </div>
                                    </div>
                                </div>
                                <div class="coupon-action-container shrink-0 flex items-center justify-end">
                                    <% if (isApplied) { %>
                                        <span class="applied-badge px-3.5 py-1.5 bg-cyber-green/20 text-cyber-green border border-cyber-green/40 rounded-lg text-xs font-bold flex items-center gap-1.5">
                                            <i class="fa-solid fa-check"></i> Applied
                                        </span>
                                    <% } else { %>
                                        <button type="button" class="apply-coupon-card-btn px-4 py-1.5 bg-cyber-blue hover:bg-blue-400 text-black font-bold text-xs rounded-lg transition-colors cursor-pointer" data-code="<%= c.code %>">
                                            Apply
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-text-secondary text-xs py-2">No coupons currently meet requirements for this cart subtotal.</div>
                    <% } %>
                </div>

                <!-- Ineligible / Requirement Not Met Coupons -->
                <% if (typeof ineligibleCoupons !== 'undefined' && ineligibleCoupons.length > 0) { %>
                    <div class="border-t border-dark-border/60 pt-3 mt-1">
                        <span class="text-[11px] text-text-tertiary uppercase font-semibold block mb-2 tracking-wider">
                            COUPONS WITH HIGHER MINIMUM ORDER REQUIREMENTS
                        </span>
                        <div class="space-y-2">
                            <% ineligibleCoupons.forEach(c => { %>
                                <div class="p-3 rounded-lg border border-dark-border/60 bg-dark-surface/40 opacity-75 flex items-center justify-between gap-2 text-xs">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono font-bold text-text-secondary uppercase"><%= c.code %></span>
                                        <span class="text-text-tertiary">• <%= c.discountDisplay %></span>
                                    </div>
                                    <span class="text-[11px] text-amber-400/90 font-mono">
                                        Add ₹<%= c.minRupeesNeeded %> more to unlock
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Currently Applied Coupon Bar -->
                <div id="applied-coupon-pill" class="<%= cart.appliedCoupon ? '' : 'hidden' %> p-3 bg-cyber-green/10 border border-cyber-green/30 rounded-lg flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-tags text-cyber-green"></i>
                        <span>Applied Coupon: <strong id="applied-code-text" class="font-mono text-white uppercase"><%= cart.appliedCoupon ? cart.appliedCoupon.code : '' %></strong></span>
                        <span class="text-cyber-green font-bold">(Saved ₹<span id="applied-savings-text"><%= cart.discount ? (cart.discount / 100).toFixed(2) : '0.00' %></span>)</span>
                    </div>
                    <button type="button" id="remove-coupon-btn" class="text-xs text-red-400 hover:text-red-300 font-bold transition-colors cursor-pointer flex items-center gap-1">
                        <i class="fa-solid fa-xmark"></i> Remove
                    </button>
                </div>

                <h2 class="font-semibold text-xs tracking-wider text-text-primary uppercase flex items-center gap-2 mt-2">
                    <i class="fa-solid fa-tag text-text-secondary"></i> APPLY OPERATIONAL PROMO CODE
                </h2>
                <div class="flex gap-3">
                    <div class="relative flex-1">
                        <input id="manual-coupon-input"
                            class="w-full bg-dark-surface-2 border border-dark-border rounded-lg p-3 text-sm font-mono uppercase focus:border-cyber-blue focus:outline-none"
                            placeholder="ENTER COUPON CODE" type="text" value="<%= cart.appliedCoupon ? cart.appliedCoupon.code : '' %>" />
                        <div class="absolute right-3.5 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-cyber-green">
                        </div>
                    </div>
                    <button type="button" id="apply-manual-coupon-btn"
                        class="bg-cyber-blue hover:bg-blue-400 text-black font-bold text-xs px-5 rounded-lg whitespace-nowrap transition-colors cursor-pointer">
                        APPLY CODE
                    </button>
                </div>
            </div>

            <!-- Pay Button Area -->
            <div class="mt-2 flex flex-col gap-3">
                <button id="submit-pay-btn"
                    class="w-full bg-cyber-blue hover:bg-blue-400 text-black font-bold py-4 rounded-xl text-base transition-all flex justify-center items-center gap-2 shadow-[0_0_20px_rgba(0,176,255,0.35)] cursor-pointer">
                    Pay ₹<%= (cart.grandTotal / 100).toFixed(2) %>
                </button>
                <div id="razorpay-secure-badge" class="text-center text-xs text-text-tertiary flex items-center justify-center gap-1">
                    <i class="fa-solid fa-shield-halved"></i> Secured by Razorpay
                </div>
            </div>
        </div>
        <!-- END: Left Column -->
        <!-- BEGIN: Right Column (Order Summary) -->
        <div class="w-full lg:w-[440px] xl:w-[480px] shrink-0">
            <div class="glass-panel rounded-2xl p-6 md:p-8 border border-[#1f2937] shadow-2xl">
                <h2 class="font-bold text-sm tracking-widest text-white uppercase mb-6">ADVANCED ORDER LEDGER</h2>
                <% if (cart && cart.items && cart.items.length > 0) { %>
                    <% cart.items.forEach(item => { %>
                        <% if (item.product) { %>
                            <!-- Product Item -->
                            <div class="flex gap-4 mb-6 pb-6 border-b border-dark-border/60 last:border-b-0">
                                <img alt="<%= item.product.title %> Cover"
                                    class="w-[72px] h-[96px] object-cover rounded-lg shadow-lg border border-dark-border shrink-0"
                                    src="<%= item.product.cover_image || item.product.coverImage || item.product.coverImageUrl || '' %>" />
                                <div class="flex flex-col justify-center min-w-0">
                                    <div class="font-bold text-base text-white leading-tight mb-1 truncate"><%= item.product.title %></div>
                                    <div class="text-[10px] font-mono text-cyber-blue flex items-center gap-1 mb-2">
                                        <i class="fa-regular fa-circle-play"></i> <%= (item.platform || '').toUpperCase() %> PHYSICAL DISK
                                    </div>
                                    <div class="text-xs text-text-secondary">
                                        Price: ₹<%= (item.product.price / 100).toFixed(2) %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } %>
                <!-- Receipt Lines -->
                <div class="space-y-4 font-mono text-xs border-t border-dashed border-dark-border pt-6 pb-6">
                    <% if (cart && cart.items && cart.items.length > 0) { %>
                        <% cart.items.forEach(item => { %>
                            <% if (item.product) { %>
                                <div class="flex justify-between items-center">
                                    <span class="text-text-secondary truncate mr-2"><%= item.product.title %> (x<%= item.quantity %>)</span>
                                    <span class="text-white shrink-0">₹<%= ((item.product.price * item.quantity) / 100).toFixed(2) %></span>
                                </div>
                            <% } %>
                        <% }) %>
                    <% } %>

                    <!-- Promos Box Container -->
                    <div id="summary-discount-row" class="<%= cart.discount > 0 ? '' : 'hidden' %> border border-cyber-green/30 bg-cyber-green/5 rounded-md p-3 space-y-2 relative overflow-hidden">
                        <div class="absolute top-0 left-0 w-1 h-full bg-cyber-green"></div>
                        <div class="text-cyber-green font-bold text-[10px] uppercase flex items-center justify-between mb-1">
                            <span class="flex items-center gap-1"><i class="fa-solid fa-tags"></i> OPERATIONAL PROMO APPLIED</span>
                            <span id="summary-coupon-code-tag" class="font-mono text-white"><%= cart.appliedCoupon ? cart.appliedCoupon.code : '' %></span>
                        </div>
                        <div class="flex justify-between items-center text-text-secondary">
                            <span>Discount</span>
                            <span class="text-cyber-green font-bold" id="summary-discount-display">-₹<%= (cart.discount / 100).toFixed(2) %></span>
                        </div>
                    </div>

                    <div class="flex justify-between items-center pt-2">
                        <span class="text-text-secondary">Subtotal</span>
                        <span class="text-white" id="summary-subtotal-display">₹<%= (cart.subtotal / 100).toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-text-secondary">GST (<%= (typeof cart !== 'undefined' && cart.items && cart.items.length > 0 && cart.items[0].product && cart.items[0].product.gst_rate) ? cart.items[0].product.gst_rate : (typeof gst_rate !== 'undefined' ? gst_rate : 18) %>%)</span>
                        <span class="text-white" id="summary-tax-display">₹<%= (cart.tax / 100).toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-text-secondary">Shipping</span>
                        <span class="text-white" id="summary-shipping-display">₹<%= (cart.shipping / 100).toFixed(2) %></span>
                    </div>
                </div>
                <!-- Total -->
                <div class="border-t border-dark-border pt-6 pb-2 flex justify-between items-end">
                    <div class="font-bold text-sm text-white">Grand Total Due</div>
                    <div class="text-3xl font-bold text-cyber-blue font-mono font-semibold" id="summary-grand-total-display">₹<%= (cart.grandTotal / 100).toFixed(2) %></div>
                </div>
                <!-- Disclaimer -->

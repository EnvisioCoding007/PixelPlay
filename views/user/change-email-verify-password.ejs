<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/png" href="/icons/brand_logo/pixelplay-logo.png">
    <link rel="shortcut icon" type="image/png" href="/icons/brand_logo/pixelplay-logo.png">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Security Verification — Change Email · PixelPlay</title>
    <link rel="stylesheet" href="/globals.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        /** @type {import('tailwindcss').Config} */
        tailwind.config = {
            theme: {
                extend: {},
            },
            plugins: [],
        }
    </script>
</head>

<body class="bg-zinc-950 text-white min-h-screen flex flex-col">
    <main
        class="flex flex-col min-h-screen items-start relative [background:linear-gradient(180deg,rgba(14,165,233,0.03)_2%,rgba(14,165,233,0)_2%),linear-gradient(90deg,rgba(14,165,233,0.03)_2%,rgba(14,165,233,0)_2%),linear-gradient(0deg,rgba(9,9,11,1)_0%,rgba(9,9,11,1)_100%)]">
        <section
            class="flex items-center justify-center px-4 sm:px-6 py-8 sm:py-12 relative self-stretch w-full flex-[0_0_auto] min-h-screen">
            <!-- Radial background glow -->
            <div aria-hidden="true"
                class="absolute top-[calc(50.00%_-_300px)] left-[calc(50.00%_-_300px)] w-[600px] h-[600px] [background:radial-gradient(50%_50%_at_50%_50%,rgba(14,165,233,0.1)_0%,rgba(14,165,233,0)_70%)] pointer-events-none">
            </div>

            <div
                class="flex flex-col max-w-lg w-full items-start gap-7 px-6 sm:px-10 py-8 sm:py-12 relative bg-[#121215bf] rounded-2xl border border-solid border-zinc-800 shadow-[0px_0px_20px_#0ea5e91a,0px_16px_40px_#00000099] backdrop-blur-[10px] backdrop-brightness-[100%] [-webkit-backdrop-filter:blur(10px)_brightness(100%)]">
                
                <!-- Border ambient glow -->
                <div aria-hidden="true"
                    class="absolute w-full h-full top-0 left-0 rounded-2xl [background:linear-gradient(140deg,rgba(14,165,233,0.35)_0%,rgba(14,165,233,0)_40%,rgba(14,165,233,0)_60%,rgba(14,165,233,0.35)_100%)] pointer-events-none">
                </div>

                <!-- Brand Header -->
                <header class="flex flex-col items-center justify-center gap-2 relative self-stretch w-full">
                    <img class="relative w-24 h-24 object-contain" src="/icons/brand_logo/pixelplay-logo.png" alt="PixelPlay logo" />
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-sky-500/10 border border-sky-500/20 rounded-full">
                        <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
                        <span class="text-xs font-semibold text-sky-400 uppercase tracking-widest">Step 1 of 2: Security Verification</span>
                    </div>
                </header>

                <!-- Titles -->
                <section class="flex flex-col items-center gap-2 relative self-stretch w-full text-center">
                    <h1 class="[font-family:'Inter-Bold',Helvetica] font-bold text-zinc-100 text-2xl tracking-[-0.50px]">
                        Verify Your Password
                    </h1>
                    <p class="[font-family:'Inter-Regular',Helvetica] font-normal text-zinc-400 text-sm leading-relaxed max-w-sm">
                        To update your email address, please confirm your current account password for security.
                    </p>
                    <div class="mt-2 text-xs text-zinc-500 [font-family:'Inter-Medium',Helvetica]">
                        Current Email: <span class="text-zinc-300 font-semibold"><%= user.email %></span>
                    </div>
                </section>

                <!-- Top Alert container for general/server messages -->
                <div id="general-error"
                    class="hidden w-full p-3 text-xs text-red-400 bg-red-950/60 border border-red-800/80 rounded-lg text-center font-medium">
                </div>

                <!-- Verification Form -->
                <form id="verify-password-form" class="flex flex-col items-start gap-6 relative self-stretch w-full" novalidate>
                    <div class="flex flex-col items-start gap-2 relative self-stretch w-full">
                        <label for="password"
                            class="relative flex items-center self-stretch [font-family:'Inter-Medium',Helvetica] font-medium text-zinc-300 text-xs uppercase tracking-wider">
                            Current Password
                        </label>
                        <div id="password-wrapper"
                            class="bg-zinc-950 overflow-hidden border border-solid border-zinc-800 flex items-center justify-center relative self-stretch w-full rounded-lg transition-colors focus-within:border-sky-500">
                            <img class="absolute top-3.5 left-[17px] w-5 h-5 z-10 pointer-events-none opacity-60"
                                src="/icons/lock-icon.svg" alt="" aria-hidden="true" />
                            <input id="password" name="password" type="password" placeholder="Enter your current password"
                                autocomplete="current-password"
                                class="flex flex-col items-start pt-[14px] pb-[14px] pl-11 pr-11 relative flex-1 grow bg-transparent [font-family:'Inter-Regular',Helvetica] font-normal text-zinc-100 text-sm tracking-[0.5px] border-0 outline-none placeholder:text-zinc-600" />
                            <button type="button" id="toggle-password-btn" aria-label="Show password"
                                class="absolute top-3.5 right-[17px] w-5 h-5 p-0 border-0 bg-transparent cursor-pointer text-zinc-500 hover:text-zinc-300 transition-colors">
                                <img class="w-5 h-5" src="/icons/eye-password-close.svg" alt="" aria-hidden="true" />
                            </button>
                        </div>
                        <span id="password-error" class="text-xs text-red-400 font-medium hidden block mt-1"></span>
                    </div>

                    <!-- Action Buttons: Proceed & Cancel -->
                    <div class="flex flex-col sm:flex-row items-center gap-3 relative self-stretch w-full pt-2">
                        <a href="/profile/edit" id="btn-cancel-password"
                            class="flex-1 w-full text-center py-3.5 px-4 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white font-medium text-sm rounded-lg border border-zinc-800 transition-colors cursor-pointer">
                            Cancel
                        </a>
                        <button type="submit" id="btn-proceed-password"
                            class="flex-1 w-full py-3.5 px-4 bg-sky-500 hover:bg-sky-400 text-zinc-950 font-bold text-sm rounded-lg shadow-[0px_0px_15px_#0ea5e966] transition-all cursor-pointer flex items-center justify-center gap-2">
                            <span>Proceed</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                            </svg>
                        </button>
                    </div>
                </form>

            </div>
        </section>
    </main>

    <script>
        (function () {
            const form = document.getElementById('verify-password-form');
            const passwordInput = document.getElementById('password');
            const passwordWrapper = document.getElementById('password-wrapper');
            const passwordError = document.getElementById('password-error');
            const generalError = document.getElementById('general-error');
            const togglePasswordBtn = document.getElementById('toggle-password-btn');
            const proceedBtn = document.getElementById('btn-proceed-password');

            // Toggle show/hide password
            if (togglePasswordBtn && passwordInput) {
                togglePasswordBtn.addEventListener('click', function () {
                    const img = togglePasswordBtn.querySelector('img');
                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        img.src = '/icons/eye-password-open.svg';
                        togglePasswordBtn.setAttribute('aria-label', 'Hide password');
                    } else {
                        passwordInput.type = 'password';
                        img.src = '/icons/eye-password-close.svg';
                        togglePasswordBtn.setAttribute('aria-label', 'Show password');
                    }
                });
            }

            function setFieldError(msg) {
                passwordError.textContent = msg;
                passwordError.classList.remove('hidden');
                passwordWrapper.classList.remove('border-zinc-800', 'focus-within:border-sky-500');
                passwordWrapper.classList.add('border-red-500');
            }

            function clearFieldError() {
                passwordError.textContent = '';
                passwordError.classList.add('hidden');
                passwordWrapper.classList.remove('border-red-500');
                passwordWrapper.classList.add('border-zinc-800', 'focus-within:border-sky-500');
                generalError.classList.add('hidden');
                generalError.textContent = '';
            }

            // Only clear errors when user types (not on focus, so errors remain readable)
            passwordInput.addEventListener('input', clearFieldError);

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                clearFieldError();

                const password = passwordInput.value;
                if (!password) {
                    setFieldError('Password is required.');
                    return;
                }

                // Loading state
                const originalBtnContent = proceedBtn.innerHTML;
                proceedBtn.disabled = true;
                proceedBtn.classList.add('opacity-70', 'cursor-not-allowed');
                proceedBtn.innerHTML = '<span class="inline-block w-4 h-4 border-2 border-zinc-950 border-t-transparent rounded-full animate-spin"></span> Verifying…';

                try {
                    const response = await fetch('/profile/change-email/verify-password', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({ password })
                    });

                    const data = await response.json().catch(() => null);

                    if (response.ok && data && data.success) {
                        window.location.href = data.redirectUrl || '/profile/change-email';
                    } else {
                        const errorMsg = (data && data.message) ? data.message : 'Incorrect password. Please try again.';
                        setFieldError(errorMsg);
                    }
                } catch (err) {
                    generalError.textContent = 'A network error occurred. Please check your connection and try again.';
                    generalError.classList.remove('hidden');
                } finally {
                    proceedBtn.disabled = false;
                    proceedBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                    proceedBtn.innerHTML = originalBtnContent;
                }
            });
        })();
    </script>
</body>

</html>

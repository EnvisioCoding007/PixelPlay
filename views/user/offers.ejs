<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/icons/brand_logo/pixelplay-logo.png">
    <link rel="shortcut icon" type="image/png" href="/icons/brand_logo/pixelplay-logo.png">
    <title>Active Deals & Special Offers · PixelPlay</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#00A3FF',
                            dark: '#0082CC',
                            light: '#33B5FF',
                        },
                        legend: {
                            DEFAULT: '#FFB800',
                            dark: '#CC9300',
                            light: '#FFC633',
                        }
                    }
                },
            },
            plugins: [],
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-panel {
            background: rgba(18, 18, 21, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen flex flex-col">
    <%- include('../partials/user/navbar', { activeTab: 'offers', user: user }) %>

    <main class="flex-1 max-w-[1720px] 2xl:max-w-[1840px] mx-auto px-4 sm:px-6 lg:px-8 2xl:px-12 w-full py-6 sm:py-10 space-y-8">
        <!-- Hero Header -->
        <div class="glass-panel p-8 rounded-2xl relative overflow-hidden border border-sky-500/20 shadow-2xl">
            <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                <div>
                    <div class="inline-flex items-center gap-2 bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-bold px-3 py-1 rounded-full mb-3">
                        <i class="fa-solid fa-bolt text-xs animate-pulse"></i>
                        <span>LIMITED TIME PROMOTIONS</span>
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight flex items-center gap-3">
                        Active Deals &amp; Offers
                    </h1>
                    <p class="text-zinc-400 text-sm md:text-base mt-2 max-w-2xl">
                        Take advantage of active game price drops, publisher sales, and category-wide discounts. All offers are automatically applied at checkout!
                    </p>
                </div>

                <div class="flex items-center gap-3 bg-zinc-900/80 border border-zinc-800 px-4 py-3 rounded-xl">
                    <div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400">
                        <i class="fa-solid fa-tags text-lg"></i>
                    </div>
                    <div>
                        <span class="text-xs text-zinc-400 block font-medium">Available Offers</span>
                        <span class="text-lg font-bold text-white"><%= (typeof offers !== 'undefined' && offers) ? offers.length : 0 %> Active Deals</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Offers List Container -->
        <% if (typeof offers !== 'undefined' && offers && offers.length > 0) { %>
            <div class="space-y-6">
                <% offers.forEach(offer => { %>
                    <div class="glass-panel rounded-2xl p-6 md:p-8 space-y-6 border border-zinc-800 hover:border-sky-500/40 transition-all duration-300 shadow-xl relative">
                        <!-- Top Bar: Header & Badges -->
                        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-zinc-800/80 pb-6">
                            <div class="space-y-2">
                                <div class="flex flex-wrap items-center gap-3">
                                    <% if (offer.targetType === 'Category') { %>
                                        <span class="bg-purple-500/10 text-purple-400 border border-purple-500/30 text-xs px-3 py-1 rounded-full font-semibold flex items-center gap-1.5">
                                            <i class="fa-solid <%= offer.targetIcon %> text-xs"></i> Category: <%= offer.targetName %>
                                        </span>
                                    <% } else if (offer.targetType === 'Product') { %>
                                        <span class="bg-sky-500/10 text-sky-400 border border-sky-500/30 text-xs px-3 py-1 rounded-full font-semibold flex items-center gap-1.5">
                                            <i class="fa-solid <%= offer.targetIcon %> text-xs"></i> Game: <%= offer.targetName %>
                                        </span>
                                    <% } else { %>
                                        <span class="bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs px-3 py-1 rounded-full font-semibold flex items-center gap-1.5">
                                            <i class="fa-solid <%= offer.targetIcon %> text-xs"></i> Publisher: <%= offer.targetName %>
                                        </span>
                                    <% } %>

                                    <!-- Expiry Badge -->
                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-rose-400 bg-rose-500/10 border border-rose-500/20 px-3 py-1 rounded-full">
                                        <i class="fa-solid fa-clock text-xs animate-pulse"></i>
                                        <span><%= offer.expiresInText %></span>
                                    </span>
                                </div>

                                <h2 class="text-xl md:text-2xl font-bold text-white"><%= offer.title %></h2>
                                <% if (offer.description) { %>
                                    <p class="text-zinc-400 text-sm max-w-3xl"><%= offer.description %></p>
                                <% } %>
                            </div>

                            <!-- Discount Tag -->
                            <div class="flex flex-col items-end flex-shrink-0">
                                <div class="bg-gradient-to-r from-sky-500 to-cyan-400 text-zinc-950 font-black text-xl md:text-2xl px-5 py-2 rounded-xl shadow-lg shadow-sky-500/20">
                                    <%= offer.discountDisplay %>
                                </div>
                                <span class="text-[11px] text-zinc-500 mt-1">Valid until <%= offer.formattedExpiry %></span>
                            </div>
                        </div>

                        <!-- On Sale Games Section -->
                        <% if (offer.matchingProducts && offer.matchingProducts.length > 0) { %>
                            <div class="space-y-3">
                                <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider flex items-center gap-2">
                                    <i class="fa-solid fa-gamepad text-sky-400"></i> Games Included in this Offer:
                                </h3>

                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                    <% offer.matchingProducts.forEach(game => { %>
                                        <a href="/products/<%= game._id %>" class="bg-zinc-900/90 border border-zinc-800/80 hover:border-sky-500/50 rounded-xl p-3 flex gap-3.5 items-center transition-all group cursor-pointer">
                                            <img src="<%= game.coverImageUrl || '/img/games/neon_override_hero.png' %>" alt="<%= game.title %>" class="w-16 h-20 object-cover rounded-lg flex-shrink-0 border border-zinc-800 group-hover:scale-105 transition-transform duration-200" />
                                            <div class="flex-1 min-w-0">
                                                <h4 class="text-sm font-semibold text-white truncate group-hover:text-sky-400 transition-colors"><%= game.title %></h4>
                                                <p class="text-xs text-zinc-400 truncate mt-0.5"><%= game.publisher %></p>
                                                <div class="mt-2 flex items-center gap-2">
                                                    <% if (game.price > game.discountedPrice) { %>
                                                        <span class="text-xs text-zinc-500 line-through">₹<%= (game.price / 100).toFixed(2) %></span>
                                                    <% } %>
                                                    <span class="text-sm font-bold text-sky-400">₹<%= (game.discountedPrice / 100).toFixed(2) %></span>
                                                </div>
                                            </div>
                                        </a>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Card Action Footer -->
                        <div class="flex items-center justify-between pt-2">
                            <span class="text-xs text-zinc-500">Auto-applied at checkout</span>
                            <a href="<%= offer.browseUrl %>" class="inline-flex items-center gap-2 text-xs font-bold text-sky-400 hover:text-sky-300 bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/20 px-4 py-2 rounded-lg transition-all">
                                <span>Browse All <%= offer.targetName %> Deals</span>
                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="glass-panel p-16 rounded-2xl text-center space-y-4 border border-zinc-800 max-w-2xl mx-auto">
                <div class="w-20 h-20 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-600 mx-auto">
                    <i class="fa-solid fa-tags text-3xl text-zinc-500"></i>
                </div>
                <h2 class="text-xl font-bold text-white">No Active Offers Right Now</h2>
                <p class="text-zinc-400 text-sm max-w-md mx-auto">
                    All promotional sales have concluded for the moment. Check back soon for exciting publisher discounts and game price drops!
                </p>
                <div class="pt-2">
                    <a href="/browse" class="inline-flex items-center gap-2 bg-sky-500 hover:bg-sky-400 text-zinc-950 font-bold text-sm px-6 py-2.5 rounded-lg shadow-lg shadow-sky-500/20 transition-all">
                        <i class="fa-solid fa-compass"></i>
                        <span>Explore Full Catalog</span>
                    </a>
                </div>
            </div>
        <% } %>
    </main>

    <%- include('../partials/user/footer') %>
</body>
</html>
